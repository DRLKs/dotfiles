{
  "layer": "top",
  "position": "top",
  "height": 28,
  "modules-left": ["custom/arch", "hyprland/workspaces"],
  "modules-center": [],
  "modules-right": [
    "custom/intellij",
    "custom/GitHubDesktop",
    "pulseaudio",
    "cpu",
    "memory",
    "temperature",
    "battery",
    "network",
    "clock",
    "tray"
  ],

  // Ícono de Arch Linux
  "custom/arch": {
    "format": "",  // logo Arch
    "tooltip": false,
    "interval": 3600
  },

  "hyprland/workspaces": {
    "format": "{icon}",
    "on-click": "activate",
    "on-scroll-up": "hyprctl dispatch workspace e+1",
    "on-scroll-down": "hyprctl dispatch workspace e-1",
    "format-icons": {
      "1": "",
      "2": "",
      "3": "",
      "4": "",
      "5": "",
      "default": ""
    }
  },

  "custom/intellij": {
    "format": "", 
    "tooltip": "Abrir IntelliJ IDEA",
    "on-click": "intellij-idea-ultimate-edition",  // Comando Abrir IntelliJ
    "interval": 3600  // Intervalo actualización
  },

  "custom/GitHubDesktop": {
    "format": "",  
    "tooltip": "Abrir GitHub Desktop",
    "on-click": "github-desktop", 
    "interval": 3600  // no necesita actualizar constantemente
  },

  "clock": {
        // "timezone": "Spain/Europe",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format-alt": "{:%d-%m-%Y}"
  },
  "battery": {
    "format": "{icon} {capacity}%",
    "format-icons": ["", "", "", "", ""],
    "interval": 30
  },

  "cpu": {
    "format": " {usage}%",
    "interval": 5
  },

  "memory": {
    "format": " {}%",
    "interval": 5
  },

  "temperature": {
    "format": " {temperatureC}°C",
    "critical-threshold": 75
  },

  "network": {
    "format-wifi": " {essid}",
    "format-ethernet": "󰈀 {ipaddr}",
    "format-disconnected": "󰖪",
    "tooltip-format": "{ifname} via {gwaddr}  {bandwidthUpBits}  {bandwidthDownBits}"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰖁 Muted",
    "format-icons": {
      "default": ["", "", ""]
    },
    "on-click": "pavucontrol"
  },

  "tray": {
    "spacing": 10
  }
}
